{
  "id": "/whendidi-pwa/",
  "name": "WhenDidI — Event Tracker",
  "short_name": "WhenDidI",
  "description": "Event tracker — log when things happen and review your history. Offline-first.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "lang": "en-US",
  "dir": "ltr",
  "categories": ["health", "lifestyle", "productivity", "utilities"],
  "background_color": "#fafafa",
  "theme_color": "#5a3a1c",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
